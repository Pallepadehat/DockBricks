{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dockbricks",
  "version": "0.1.3",
  "identifier": "com.pallepadehat.dockbricks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DockBricks",
        "width": 850,
        "height": 650,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3QUI4MkQ2MzQwNUM0NDAKUldSQXhBVTAxb0tyNXgveWQwNnFibVR4cHQ3c3ZzRFNXalQ0dkhKYnRNV1FueEwzRm5Xck0vejEK",
      "endpoints": [
        "https://github.com/pallepadehat/DockBricks/releases/latest/download/latest.json"
      ]
    }
  }
}
